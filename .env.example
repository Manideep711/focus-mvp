# Public browser configuration. These are intentionally public.
VITE_SUPABASE_URL=
VITE_SUPABASE_PUBLISHABLE_KEY=
VITE_GOOGLE_AUTH_ENABLED=false
# AI is served by a server-side API at /api/ai (Vite bridge locally, Pages Functions in production).
# Server-only secrets belong in Cloudflare settings / .dev.vars, NEVER VITE_*:
# SUPABASE_URL=
# SUPABASE_PUBLISHABLE_KEY=
# GROQ_API_KEY=
# AI_MODEL=openai/gpt-oss-20b
